/*******************************************************************************
 * ROFI Color theme
 * Based on Adapta-Nokto Rofi theme
 * User: TabTray
 ********************************************************************************/

* {
    red:                         rgba ( 220, 50, 47, 100 % );
    blue:                        rgba ( 38, 139, 210, 100 % );
    lightbg:                     rgba ( 238, 232, 213, 100 % );
    lightfg:                     rgba ( 88, 104, 117, 100 % );
    background:                  rgba ( 58, 76, 84, 50 % );
    foreground:                  rgba ( 250, 251, 252, 100 % );
    bordercolor:                 rgba ( 42, 55, 62, 100 % );
    border-color:                @foreground;
    separatorcolor:              rgba ( 195, 198, 200, 100 % );
    normal-background:           rgba ( 69, 90, 100, 50 % );
    normal-foreground:           @foreground;
    active-background:           rgba ( 69, 90, 100, 100 % );
    active-foreground:           rgba ( 0, 188, 212, 100 % );
    urgent-background:           rgba ( 69, 90, 100, 100 % );
    urgent-foreground:           rgba ( 255, 82, 82, 100 % );
    selected-normal-background:  rgba ( 50, 175, 212, 60 % );
    selected-normal-border:      rgba ( 100, 200, 255, 100 % );
    selected-normal-foreground:  rgba ( 250, 251, 252, 100 % );
    selected-active-background:  rgba ( 0, 150, 136, 100 % );
    selected-active-foreground:  rgba ( 253, 246, 227, 100 % );
    selected-urgent-background:  rgba ( 255, 82, 82, 100 % );
    selected-urgent-foreground:  rgba ( 253, 246, 227, 100 % );
    alternate-normal-background: rgba ( 69, 90, 100, 75 % );
    alternate-normal-foreground: @foreground;
    alternate-active-background: rgba ( 69, 90, 100, 100 % );
    alternate-active-foreground: @active-foreground;
    alternate-urgent-background: rgba ( 69, 90, 100, 100 % );
    alternate-urgent-foreground: @urgent-foreground;
    background-color:            rgba ( 0, 0, 0, 0 % );
    spacing:                     2;
}
window {
    background-color: @background;
    border: 1;
    padding: 5;
    border-radius: 8px;
}
mainbox {
    border:  0;
    padding: 0;
}
message {
    border: 1px dash 0px 0px;
    border-color: @separatorcolor;
    padding: 1px;
}
textbox {
    text-color: @foreground;
}
listview {
    fixed-height: 0;
    border: 2px dash 0px 2px dash;
    border-color: @separatorcolor;
    spacing: 2px;
    scrollbar: true;
    padding: 2px 0px 0px;
    lines: 12;
}
element {
    border: 0;
    padding: 1px;
    border-radius: 10px;
}
element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
element-icon {
    size: 1.25em;
    padding: 5px;
}

element normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
    border-color: @selected-normal-border;
    border: 1;
}
element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
element.alternate.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element.alternate.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element.alternate.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
scrollbar {
    width: 4px;
    border: 0;
    handle-width: 8px;
    padding: 0;
    handle-color: @lightbg;
}
mode-switcher {
    border-radius: 5px;
}
button {
    background-color: @alternate-normal-background;
    text-color: @alternate-normal-foreground;
}
button.selected {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}
inputbar {
    spacing: 0;
    text-color: @normal-foreground;
    padding: 1px;
}
case-indicator {
    spacing: 0;
    text-color: @normal-foreground;
}
entry {
    spacing: 0;
    text-color: @normal-foreground;
}
prompt {
    spacing: 0;
    text-color: @normal-foreground;
}
inputbar {
    children: [ textbox-prompt-colon,entry,case-indicator ];
}
textbox-prompt-colon {
    expand: false;
    str: ">";
    margin: 0px 0.3em 0em 0em;
    text-color: @normal-foreground;
}
