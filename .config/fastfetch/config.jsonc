{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "",
    "color": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": ""
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
    }
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": true,
    "disableLinewrap": true,
    "hideCursor": false,
    "separator": " ",
    "color": {
      "keys": "",
      "title": "",
      "output": "#FFFFFF",
      "separator": ""
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default"
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default"
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default",
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-"
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": ""
      },
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97"
      },
      "width": 10
    },
    "fraction": {
      "ndigits": 2
    },
    "key": {
      "width": 8,
      "paddingLeft": 0
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "constants": []
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "dsForceDrm": false
  },
  "modules": [
    {
      "type": "version",
      "key": " ",
      "format": "{#1;36}┍━━━━━ {project-name} {build-type} {version} ━━━───┄┄{#}"
    },
    {
      "type": "os",
      "key": " OPER"
    },
    {
      "type": "host",
      "key": "┆ ├  "
    },
    {
      "type": "kernel",
      "key": "┆ ├  "
    },
    {
      "type": "packages",
      "key": "┆ ├ 󰏗 ",
      "combined": false
    },
    {
      "type": "uptime",
      "key": "┆ └ ⏻ "
    },
    {
      "type": "display",
      "key": "󰍹 HARD",
      "compactType": "none",
      "preciseRefreshRate": false,
      "order": "desc"
    },
    {
      "type": "cpu",
      "key": "┆ ├  ",
      "temp": false,
      "showPeCoreCount": false
    },
    {
      "type": "gpu",
      "key": "┆ ├ 󰾲 ",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": false,
      "hideType": "none",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "memory",
      "key": "┆ └  ",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "de",
      "key": "🖽 ENVM"
    },
    {
      "type": "wm",
      "key": "┆ ├  ",
      "detectPlugin": false
    },
    {
      "type": "wmtheme",
      "key": "┆ ├ 󰓸 "
    },
    {
      "type": "theme",
      "key": "┆ ├ 󰉼 "
    },
    {
      "type": "icons",
      "key": "┆ ├  "
    },
    {
      "type": "font",
      "key": "┆ ├  "
    },
    {
      "type": "cursor",
      "key": "┆ └ 󰆿 "
    },
    {
      "type": "terminal",
      "key": " TERM"
    },
    {
      "type": "shell",
      "key": "┆ ├  "
    },
    {
      "type": "terminalfont",
      "key": "┆ └  "
    },
    {
      "type": "battery",
      "key": " BATT",
      "temp": false,
      "percent": {
        "green": 50,
        "yellow": 20,
        "type": 0
      }
    },
    {
      "type": "poweradapter",
      "key": "┆ └ 󰚥 "
    },
    {
      "type": "custom",
      "format": "{#1;36}┕━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━───┄┄{#}" // its not great how this can be misaligned if the version text at the top is one character longer or shorter... but how in the world would i fix that in this format.
    },
    {
      "type": "colors",
      "key": " ",
      "symbol": "circle",
      "paddingLeft": 0,
      "block": {
        "width": 3,
        "range": [
          0,
          15
        ]
      }
    }
  ]
}
