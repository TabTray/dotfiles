[core]
	editor = helix
[user]
	name = TabTray
	email = tabtrayinquire@gmail.com
[init]
	defaultBranch = main
[pull]
	rebase = false
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
# i didnt add this lfs stuff but if its what the build.sh wants then its what the build.sh gets
[alias]
	st = status
	ci = commit
	br = branch
	co = checkout
	rt = remote
[include]
	path = ./.gitconfig.local
